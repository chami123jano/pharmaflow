{
  "name": "pharmaflow-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PharmaFlow Desktop - Pharmacy POS and Inventory",
  "author": "Your Company",
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,types,electron \"vite serve --config src/renderer/vite.config.ts --port 5173\" \"tsc -p tsconfig.main.json --watch --noEmit\" \"node scripts/start-electron.mjs\"",
    "build:main": "node scripts/build-main.mjs",
    "build:preload": "node scripts/build-main.mjs",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "build": "npm run build:main && npm run build:renderer",
    "package": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "doctor": "node scripts/doctor.mjs --fix",
    "postinstall": "node scripts/doctor.mjs --fix"
  },
  "dependencies": {
    "electron-log": "^5.1.4",
    "electron-window-state": "^5.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.0.0",
    "electron": "38.1.2",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
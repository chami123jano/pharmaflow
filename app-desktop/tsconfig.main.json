{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist/main",
    "rootDir": "src/main",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/main/**/*"],
  "exclude": ["node_modules", "dist", "src/main/db/fallback-sqlite.ts"]
}

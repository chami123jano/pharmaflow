# Both of these are public by design. The publishable key is compiled into the
# site's JavaScript and is meant to be readable — row level security in
# supabase/schema.sql is what actually guards the data, not this string.
# The service_role / secret key must never appear here.
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

VITE_SHOP_NAME=Your Pharmacy
